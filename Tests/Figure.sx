use Plot
use STD.Text

test "build a labeled line plot for a package consumer" {
    let x:float[] = [0.0, 1.0, 2.0, 3.0]
    let y:float[] = [0.0, 1.0, 4.0, 9.0]
    let svg = Plot.line(x, y, "Valeurs")
        ..title("Croissance & mesures")
        ..x_label("Temps")
        ..y_label("Valeur")
        .svg()

    assert(Text.contains(svg, "<svg"), "SVG document root")
    assert(Text.contains(svg, "<polyline"), "line series")
    assert(Text.contains(svg, "Croissance &amp; mesures"), "escaped title")
    assert(!Text.contains(svg, "data-plot-legend="), "single series needs no legend")
    assert(Text.contains(svg, "Temps"), "horizontal axis label")
    assert(Text.contains(svg, "Valeur"), "vertical axis label")
}

test "compose line and scatter series in one figure" {
    let x:float[] = [0.0, 1.0, 2.0]
    let svg = Plot.line(x, [0.0, 1.0, 4.0], "Modèle")
        ..scatter(x, [0.1, 0.8, 4.2], "Mesures")
        ..size(640, 420)
        .svg()

    assert(Text.contains(svg, "width=\"640\""), "configured width")
    assert(Text.contains(svg, "height=\"420\""), "configured height")
    assert(Text.contains(svg, "<polyline"), "line series")
    assert(Text.contains(svg, "<circle"), "scatter series")
    assert(Text.contains(svg, "r=\"4\" fill=\"rgb(45 212 191)\""), "scatter legend marker")
    assert(Text.contains(svg, "data-plot-legend=\"inline\""), "compact inline legend")
    assert(Text.contains(svg, "Modèle"), "first legend entry")
    assert(Text.contains(svg, "Mesures"), "second legend entry")
}

test "render a single point with a finite visible extent" {
    let svg = Plot.scatter([42.0], [-3.0]).svg()
    assert(Text.contains(svg, "<circle"), "single point")
    assert(!Text.contains(svg, "nan"), "finite coordinates")
}
