public struct Color {
    private let current_red:int
    private let current_green:int
    private let current_blue:int

    init(red:int, green:int, blue:int) {
        validate_channel(red)
        validate_channel(green)
        validate_channel(blue)
        self.current_red = red
        self.current_green = green
        self.current_blue = blue
    }

    static func rgb(red:int, green:int, blue:int) Color {
        return Color(red, green, blue)
    }

    package func red() int { return self.current_red }
    package func green() int { return self.current_green }
    package func blue() int { return self.current_blue }
}

public struct Palette {
    private let current_colors:Color[]

    package init() {
        self.current_colors = modern_colors()
    }

    init(colors:Color[]) {
        if colors.count() == 0 { panic("Plot palette requires at least one color") }
        self.current_colors = colors
    }

    static func modern() Palette {
        return Palette(modern_colors())
    }

    static func ocean() Palette {
        return Palette([
            Color.rgb(8, 47, 73),
            Color.rgb(3, 105, 161),
            Color.rgb(6, 182, 212),
            Color.rgb(45, 212, 191),
            Color.rgb(187, 247, 208)
        ])
    }

    static func sunset() Palette {
        return Palette([
            Color.rgb(124, 45, 18),
            Color.rgb(234, 88, 12),
            Color.rgb(251, 146, 60),
            Color.rgb(250, 204, 21),
            Color.rgb(190, 24, 93)
        ])
    }

    static func neon() Palette {
        return Palette([
            Color.rgb(34, 211, 238),
            Color.rgb(244, 114, 182),
            Color.rgb(192, 132, 252),
            Color.rgb(74, 222, 128),
            Color.rgb(250, 204, 21)
        ])
    }

    package func color(index:int) Color {
        return self.current_colors[index % self.current_colors.count()]
    }
}

func modern_colors() Color[] {
    return [
        Color.rgb(15, 118, 110),
        Color.rgb(45, 212, 191),
        Color.rgb(245, 158, 11),
        Color.rgb(239, 108, 91),
        Color.rgb(30, 64, 175),
        Color.rgb(168, 85, 247)
    ]
}

func validate_channel(value:int) {
    if value < 0 || value > 255 { panic("Plot color channels must be between 0 and 255") }
}
