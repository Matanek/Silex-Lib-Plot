use GFX.Canvas
use GFX.Viewer
use Plot.Chart.Chart
use Plot.CanvasRenderer
use Plot.SVGRenderer
use STD.Error
use STD.File

public class Figure {
    private var current_charts:Chart[]
    private var current_rows:int
    private var current_columns:int
    private var current_title:str
    private var current_width:int
    private var current_height:int

    package init(rows:int = 1, columns:int = 1) {
        if rows < 1 || columns < 1 { panic("Plot grid dimensions must be positive") }
        self.current_charts = make_charts(rows * columns)
        self.current_rows = rows
        self.current_columns = columns
        self.current_title = ""
        self.current_width = 960
        self.current_height = 640
    }

    func at(row:int, column:int) Chart {
        if row < 0 || row >= self.current_rows || column < 0 || column >= self.current_columns {
            panic("Plot chart coordinates are outside the figure grid")
        }
        return self.current_charts[row * self.current_columns + column]
    }

    func line(x:float[], y:float[], label:str = "") {
        self.first().line(x, y, label)
    }

    func scatter(x:float[], y:float[], label:str = "") {
        self.first().scatter(x, y, label)
    }

    func bar(categories:str[], values:float[], label:str = "") {
        self.first().bar(categories, values, label)
    }

    func histogram(values:float[], bins:int = 20, label:str = "") {
        self.first().histogram(values, bins, label)
    }

    func heatmap(values:float[], columns:int, label:str = "") {
        self.first().heatmap(values, columns, label)
    }

    func band(x:float[], lower:float[], upper:float[], label:str = "") {
        self.first().band(x, lower, upper, label)
    }

    func error_bars(
        x:float[],
        y:float[],
        lower:float[],
        upper:float[],
        label:str = ""
    ) {
        self.first().error_bars(x, y, lower, upper, label)
    }

    func box_plot(values:float[], label:str = "") {
        self.first().box_plot(values, label)
    }

    func candlesticks(
        x:float[],
        open:float[],
        high:float[],
        low:float[],
        close:float[],
        label:str = ""
    ) {
        self.first().candlesticks(x, open, high, low, close, label)
    }

    func horizontal(value:float, label:str = "") {
        self.first().horizontal(value, label)
    }

    func vertical(value:float, label:str = "") {
        self.first().vertical(value, label)
    }

    func title(value:str) { self.current_title = value }
    func x_label(value:str) { self.first().x_label(value) }
    func y_label(value:str) { self.first().y_label(value) }
    func x_categories(values:str[]) { self.first().x_categories(values) }
    func y_categories(values:str[]) { self.first().y_categories(values) }
    func x_log() { self.first().x_log() }
    func y_log() { self.first().y_log() }
    func x_linear() { self.first().x_linear() }
    func y_linear() { self.first().y_linear() }
    func x_decimals(digits:int) { self.first().x_decimals(digits) }
    func y_decimals(digits:int) { self.first().y_decimals(digits) }
    func x_decimals_auto() { self.first().x_decimals_auto() }
    func y_decimals_auto() { self.first().y_decimals_auto() }
    func legend_auto() { self.first().legend_auto() }
    func legend_hidden() { self.first().legend_hidden() }
    func legend_right() { self.first().legend_right() }
    func legend_inside() { self.first().legend_inside() }
    func legend_inline() { self.first().legend_inline() }
    func legend_inline_left() { self.first().legend_inline_left() }
    func legend_inline_center() { self.first().legend_inline_center() }
    func legend_inline_right() { self.first().legend_inline_right() }
    func clear() { self.first().clear() }

    func size(width:int, height:int) {
        if width < 320 || height < 240 {
            panic("Plot figure size must be at least 320 by 240 pixels")
        }
        self.current_width = width
        self.current_height = height
    }

    func show() int {
        self.require_data()
        var window_title = self.current_title
        if window_title == "" { window_title = "Silex Plot" }
        return Viewer.show(self.canvas(), self.current_width, self.current_height, window_title)
    }

    func svg() str {
        self.require_data()
        return SVGRenderer.render(self)
    }

    func save_svg(path:str) Result<void, Error> {
        return File.write_all(path, self.svg())
    }

    package func charts() Chart[] { return self.current_charts }
    package func rows() int { return self.current_rows }
    package func columns() int { return self.current_columns }
    package func heading() str { return self.current_title }
    package func pixel_width() int { return self.current_width }
    package func pixel_height() int { return self.current_height }

    package func canvas() Canvas {
        let width = self.current_width
        let height = self.current_height
        var canvas = Canvas()
        canvas.paint(func(painter:&Canvas.Painter) {
            CanvasRenderer.paint(painter, self, width, height)
        })
        return canvas
    }

    private func first() Chart { return self.current_charts[0] }

    private func require_data() {
        for chart in self.current_charts {
            if !chart.is_empty() { return }
        }
        panic("Plot figure requires at least one data series")
    }
}

func make_charts(count:int) Chart[] {
    var charts:Chart[] = []
    var index = 0
    while index < count {
        charts.append(Chart())
        index++
    }
    return charts
}
