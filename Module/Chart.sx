use STD.Math
use STD.Text.Grapheme
use Plot.Circular.Kind
use Plot.Circular.LabelPlacement
use Plot.Circular.Series
use Plot.Filled.AreaMode
use Plot.Filled.AreaSeries
use Plot.Filled.HierarchyKind
use Plot.Filled.HierarchySeries
use Plot.Style.Color
use Plot.Style.Palette

package enum Scale {
    linear
    logarithmic
}

package enum LegendPlacement {
    automatic
    hidden
    right
    inside
    inline
}

package enum LegendAlignment {
    left
    center
    right
}

package enum MarkKind {
    line
    scatter
    bar
    histogram
    heatmap
    band
    error_bars
    box_plot
    candlesticks
    sector
    area
}

package struct XYSeries {
    let x:float[]
    let y:float[]
    let label:str
    let color:int
}

package struct BarSeries {
    let categories:str[]
    let values:float[]
    let label:str
    let color:int
}

package struct HistogramSeries {
    let edges:float[]
    let counts:float[]
    let label:str
    let color:int
}

package struct HeatmapSeries {
    let values:float[]
    let columns:int
    let rows:int
    let label:str
}

package struct BandSeries {
    let x:float[]
    let lower:float[]
    let upper:float[]
    let label:str
    let color:int
}

package struct ErrorSeries {
    let x:float[]
    let y:float[]
    let lower:float[]
    let upper:float[]
    let label:str
    let color:int
}

package struct BoxSeries {
    let minimum:float
    let first_quartile:float
    let median:float
    let third_quartile:float
    let maximum:float
    let label:str
    let color:int
}

package struct CandleSeries {
    let x:float[]
    let open:float[]
    let high:float[]
    let low:float[]
    let close:float[]
    let label:str
}

package struct ReferenceLine {
    let value:float
    let label:str
}

package struct LegendEntry {
    let kind:MarkKind
    let label:str
    let color:int
}

package struct Bounds {
    var x_min:float
    var x_max:float
    var y_min:float
    var y_max:float
}

package struct Area {
    let left:float
    let top:float
    let width:float
    let height:float
}

public class Chart {
    private var current_lines:XYSeries[]
    private var current_scatters:XYSeries[]
    private var current_bars:BarSeries[]
    private var current_histograms:HistogramSeries[]
    private var current_heatmaps:HeatmapSeries[]
    private var current_bands:BandSeries[]
    private var current_errors:ErrorSeries[]
    private var current_boxes:BoxSeries[]
    private var current_candles:CandleSeries[]
    private var current_areas:AreaSeries[]
    private var current_circular:Series[]
    private var current_hierarchy:HierarchySeries[]
    private var current_horizontal:ReferenceLine[]
    private var current_vertical:ReferenceLine[]
    private var current_title:str
    private var current_x_label:str
    private var current_y_label:str
    private var current_x_categories:str[]
    private var current_y_categories:str[]
    private var current_x_scale:Scale
    private var current_y_scale:Scale
    private var current_x_decimals:int
    private var current_y_decimals:int
    private var current_legend:LegendPlacement
    private var current_legend_alignment:LegendAlignment
    private var current_palette:Palette
    private var current_inner_radius:float
    private var current_slice_gap:float
    private var current_start_angle:float
    private var current_slice_offsets:float[]
    private var current_label_placement:LabelPlacement
    private var current_percentages:bool
    private var current_area_mode:AreaMode
    private var current_fill_opacity:float
    private var current_smooth:bool
    private var next_color:int

    package init() {
        self.current_lines = []
        self.current_scatters = []
        self.current_bars = []
        self.current_histograms = []
        self.current_heatmaps = []
        self.current_bands = []
        self.current_errors = []
        self.current_boxes = []
        self.current_candles = []
        self.current_areas = []
        self.current_circular = []
        self.current_hierarchy = []
        self.current_horizontal = []
        self.current_vertical = []
        self.current_title = ""
        self.current_x_label = ""
        self.current_y_label = ""
        self.current_x_categories = []
        self.current_y_categories = []
        self.current_x_scale = Scale.linear()
        self.current_y_scale = Scale.linear()
        self.current_x_decimals = -1
        self.current_y_decimals = -1
        self.current_legend = LegendPlacement.automatic()
        self.current_legend_alignment = LegendAlignment.center()
        self.current_palette = Palette.modern()
        self.current_inner_radius = 0.0
        self.current_slice_gap = 0.0
        self.current_start_angle = -90.0
        self.current_slice_offsets = []
        self.current_label_placement = LabelPlacement.inside()
        self.current_percentages = false
        self.current_area_mode = AreaMode.overlaid()
        self.current_fill_opacity = 0.36
        self.current_smooth = false
        self.next_color = 0
    }

    func line(x:float[], y:float[], label:str = "") {
        self.require_cartesian()
        validate_xy(x, y, "line")
        self.current_lines.append(XYSeries(x:x, y:y, label:label, color:self.take_color()))
    }

    func scatter(x:float[], y:float[], label:str = "") {
        self.require_cartesian()
        validate_xy(x, y, "scatter")
        self.current_scatters.append(XYSeries(x:x, y:y, label:label, color:self.take_color()))
    }

    func area(x:float[], y:float[], label:str = "") {
        self.require_cartesian()
        validate_xy(x, y, "area")
        if self.current_areas.count() > 0 && self.current_area_mode != AreaMode.overlaid() {
            require_x_values(self.current_areas[0].x, x)
            for value in y {
                if value < 0.0 { panic("Plot stacked and normalized areas cannot contain negative values") }
            }
        }
        self.current_areas.append(AreaSeries(x:x, y:y, label:label, color:self.take_color()))
    }

    func stacked_area(x:float[], values:float[][], labels:str[] = []) {
        self.set_areas(x, values, labels, AreaMode.stacked())
        self.current_fill_opacity = 0.82
    }

    func normalized_area(x:float[], values:float[][], labels:str[] = []) {
        self.set_areas(x, values, labels, AreaMode.normalized())
        self.current_fill_opacity = 0.82
    }

    func bar(categories:str[], values:float[], label:str = "") {
        self.require_cartesian()
        if categories.count() == 0 { panic("Plot bar data cannot be empty") }
        if categories.count() != values.count() {
            panic("Plot bars require one value for each category")
        }
        validate_finite(values, "bar")
        if self.current_x_categories.count() == 0 { self.current_x_categories = categories }
        else { require_categories(self.current_x_categories, categories) }
        self.current_bars.append(BarSeries(
            categories:categories,
            values:values,
            label:label,
            color:self.take_color()
        ))
    }

    func histogram(values:float[], bins:int = 20, label:str = "") {
        self.require_cartesian()
        if values.count() == 0 { panic("Plot histogram data cannot be empty") }
        if bins < 1 { panic("Plot histogram bins must be positive") }
        validate_finite(values, "histogram")
        var minimum = values[0]
        var maximum = values[0]
        for value in values {
            minimum = Math.min(minimum, value)
            maximum = Math.max(maximum, value)
        }
        if minimum == maximum {
            minimum -= 0.5
            maximum += 0.5
        }
        let width = (maximum - minimum) / bins as float
        var edges:float[] = []
        var counts:float[] = []
        var bin = 0
        while bin <= bins {
            edges.append(minimum + bin as float * width)
            if bin < bins { counts.append(0.0) }
            bin++
        }
        for value in values {
            var index = Math.floor((value - minimum) / width) as int
            if index == bins { index = bins - 1 }
            counts[index] += 1.0
        }
        self.current_histograms.append(HistogramSeries(
            edges:edges,
            counts:counts,
            label:label,
            color:self.take_color()
        ))
    }

    func heatmap(values:float[], columns:int, label:str = "") {
        self.require_cartesian()
        if columns < 1 { panic("Plot heatmap columns must be positive") }
        if values.count() == 0 || values.count() % columns != 0 {
            panic("Plot heatmap values must form complete rows")
        }
        validate_finite(values, "heatmap")
        self.current_heatmaps.append(HeatmapSeries(
            values:values,
            columns:columns,
            rows:values.count() / columns,
            label:label
        ))
    }

    func band(x:float[], lower:float[], upper:float[], label:str = "") {
        self.require_cartesian()
        validate_xy(x, lower, "band")
        if x.count() != upper.count() { panic("Plot band bounds must match x values") }
        validate_finite(upper, "band")
        var index = 0
        while index < x.count() {
            if lower[index] > upper[index] { panic("Plot band lower bounds cannot exceed upper bounds") }
            index++
        }
        self.current_bands.append(BandSeries(
            x:x, lower:lower, upper:upper, label:label, color:self.take_color()
        ))
    }

    func error_bars(
        x:float[],
        y:float[],
        lower:float[],
        upper:float[],
        label:str = ""
    ) {
        self.require_cartesian()
        validate_xy(x, y, "error bars")
        if x.count() != lower.count() || x.count() != upper.count() {
            panic("Plot error bar bounds must match the point values")
        }
        validate_finite(lower, "error bars")
        validate_finite(upper, "error bars")
        var index = 0
        while index < x.count() {
            if lower[index] > upper[index] {
                panic("Plot error bar lower bounds cannot exceed upper bounds")
            }
            index++
        }
        self.current_errors.append(ErrorSeries(
            x:x, y:y, lower:lower, upper:upper, label:label, color:self.take_color()
        ))
    }

    func box_plot(values:float[], label:str = "") {
        self.require_cartesian()
        if values.count() == 0 { panic("Plot box plot data cannot be empty") }
        validate_finite(values, "box plot")
        var ordered:float[] = []
        for value in values { ordered.append(value) }
        sort_values(&ordered[0:ordered.count()])
        self.current_boxes.append(BoxSeries(
            minimum:ordered[0],
            first_quartile:quantile(ordered, 0.25),
            median:quantile(ordered, 0.5),
            third_quartile:quantile(ordered, 0.75),
            maximum:ordered[ordered.count() - 1],
            label:label,
            color:self.take_color()
        ))
        self.current_x_categories.append(label)
    }

    func candlesticks(
        x:float[],
        open:float[],
        high:float[],
        low:float[],
        close:float[],
        label:str = ""
    ) {
        self.require_cartesian()
        validate_xy(x, open, "candlesticks")
        if x.count() != high.count() || x.count() != low.count() || x.count() != close.count() {
            panic("Plot candlesticks require matching x, open, high, low, and close values")
        }
        validate_finite(high, "candlesticks")
        validate_finite(low, "candlesticks")
        validate_finite(close, "candlesticks")
        var index = 0
        while index < x.count() {
            if low[index] > Math.min(open[index], close[index]) ||
                high[index] < Math.max(open[index], close[index]) ||
                low[index] > high[index] {
                panic("Plot candlestick ranges must contain their open and close values")
            }
            index++
        }
        self.current_candles.append(CandleSeries(
            x:x, open:open, high:high, low:low, close:close, label:label
        ))
    }

    func horizontal(value:float, label:str = "") {
        self.require_cartesian()
        validate_value(value, "horizontal reference")
        self.current_horizontal.append(ReferenceLine(value:value, label:label))
    }

    func vertical(value:float, label:str = "") {
        self.require_cartesian()
        validate_value(value, "vertical reference")
        self.current_vertical.append(ReferenceLine(value:value, label:label))
    }

    func pie(labels:str[], values:float[]) {
        self.set_circular(labels, values, sum(values), Kind.pie())
        self.current_inner_radius = 0.0
    }

    func donut(labels:str[], values:float[]) {
        self.set_circular(labels, values, sum(values), Kind.donut())
        self.current_inner_radius = 0.58
    }

    func gauge(value:float, maximum:float = 100.0, label:str = "") {
        if !Math.is_finite(maximum) || maximum <= 0.0 {
            panic("Plot gauge maximum must be positive and finite")
        }
        if !Math.is_finite(value) || value < 0.0 || value > maximum {
            panic("Plot gauge value must be between zero and its maximum")
        }
        self.set_circular([label], [value], maximum, Kind.gauge())
        self.current_inner_radius = 0.72
        self.current_slice_gap = 0.0
        self.current_percentages = true
        self.current_label_placement = LabelPlacement.inside()
    }

    func polar_bar(labels:str[], values:float[], maximum:float = 0.0) {
        var resolved_maximum = maximum
        if resolved_maximum == 0.0 { resolved_maximum = maximum_value(values) }
        if !Math.is_finite(resolved_maximum) || resolved_maximum <= 0.0 {
            panic("Plot polar bar maximum must be positive and finite")
        }
        for value in values {
            if value > resolved_maximum { panic("Plot polar bar values cannot exceed its maximum") }
        }
        self.set_circular(labels, values, resolved_maximum, Kind.polar_bar())
        self.current_inner_radius = 0.0
    }

    func pyramid(labels:str[], values:float[]) {
        self.set_hierarchy(labels, values, HierarchyKind.pyramid())
        self.current_fill_opacity = 1.0
    }

    func funnel(labels:str[], values:float[]) {
        self.set_hierarchy(labels, values, HierarchyKind.funnel())
        self.current_fill_opacity = 1.0
    }

    func palette(value:Palette) { self.current_palette = value }

    func fill_opacity(amount:float) {
        if self.current_areas.count() == 0 && !self.is_hierarchy() {
            panic("Plot fill opacity requires an area, pyramid, or funnel chart")
        }
        if !Math.is_finite(amount) || amount < 0.0 || amount > 1.0 {
            panic("Plot fill opacity must be between 0 and 1")
        }
        self.current_fill_opacity = amount
    }

    func smooth() {
        if self.current_areas.count() == 0 { panic("Plot smoothing requires an area chart") }
        self.current_smooth = true
    }

    func straight() {
        if self.current_areas.count() == 0 { panic("Plot straight lines require an area chart") }
        self.current_smooth = false
    }

    func inner_radius(amount:float) {
        self.require_circular()
        if !Math.is_finite(amount) || amount < 0.0 || amount > 0.9 {
            panic("Plot inner radius must be between 0 and 0.9")
        }
        self.current_inner_radius = amount
    }

    func slice_gap(degrees:float) {
        self.require_circular()
        if !Math.is_finite(degrees) || degrees < 0.0 || degrees > 20.0 {
            panic("Plot slice gap must be between 0 and 20 degrees")
        }
        self.current_slice_gap = degrees
    }

    func start_angle(degrees:float) {
        self.require_circular()
        if !Math.is_finite(degrees) { panic("Plot start angle must be finite") }
        self.current_start_angle = degrees
    }

    func explode(index:int, amount:float = 0.08) {
        self.require_circular()
        if index < 0 || index >= self.current_slice_offsets.count() {
            panic("Plot exploded slice index is outside the chart")
        }
        if !Math.is_finite(amount) || amount < 0.0 || amount > 0.3 {
            panic("Plot exploded slice amount must be between 0 and 0.3")
        }
        self.current_slice_offsets[index] = amount
    }

    func labels_hidden() { self.require_labeled_shape(); self.current_label_placement = LabelPlacement.hidden() }
    func labels_inside() { self.require_labeled_shape(); self.current_label_placement = LabelPlacement.inside() }
    func labels_outside() { self.require_labeled_shape(); self.current_label_placement = LabelPlacement.outside() }
    func show_percentages() { self.require_labeled_shape(); self.current_percentages = true }
    func hide_percentages() { self.require_labeled_shape(); self.current_percentages = false }

    func title(value:str) { self.current_title = value }
    func x_label(value:str) { self.current_x_label = value }
    func y_label(value:str) { self.current_y_label = value }
    func x_categories(values:str[]) { self.current_x_categories = values }
    func y_categories(values:str[]) { self.current_y_categories = values }
    func x_log() { self.current_x_scale = Scale.logarithmic() }
    func y_log() { self.current_y_scale = Scale.logarithmic() }
    func x_linear() { self.current_x_scale = Scale.linear() }
    func y_linear() { self.current_y_scale = Scale.linear() }

    func x_decimals(digits:int) {
        validate_decimals(digits)
        self.current_x_decimals = digits
    }

    func y_decimals(digits:int) {
        validate_decimals(digits)
        self.current_y_decimals = digits
    }

    func x_decimals_auto() { self.current_x_decimals = -1 }
    func y_decimals_auto() { self.current_y_decimals = -1 }
    func legend_auto() { self.current_legend = LegendPlacement.automatic() }
    func legend_hidden() { self.current_legend = LegendPlacement.hidden() }
    func legend_right() { self.current_legend = LegendPlacement.right() }
    func legend_inside() { self.current_legend = LegendPlacement.inside() }
    func legend_inline() { self.current_legend = LegendPlacement.inline() }

    func legend_inline_left() {
        self.current_legend = LegendPlacement.inline()
        self.current_legend_alignment = LegendAlignment.left()
    }

    func legend_inline_center() {
        self.current_legend = LegendPlacement.inline()
        self.current_legend_alignment = LegendAlignment.center()
    }

    func legend_inline_right() {
        self.current_legend = LegendPlacement.inline()
        self.current_legend_alignment = LegendAlignment.right()
    }

    func clear() {
        self.current_lines = []
        self.current_scatters = []
        self.current_bars = []
        self.current_histograms = []
        self.current_heatmaps = []
        self.current_bands = []
        self.current_errors = []
        self.current_boxes = []
        self.current_candles = []
        self.current_areas = []
        self.current_circular = []
        self.current_hierarchy = []
        self.current_horizontal = []
        self.current_vertical = []
        self.current_x_categories = []
        self.current_y_categories = []
        self.current_slice_offsets = []
        self.next_color = 0
    }

    package func lines() XYSeries[] { return self.current_lines }
    package func scatters() XYSeries[] { return self.current_scatters }
    package func bars() BarSeries[] { return self.current_bars }
    package func histograms() HistogramSeries[] { return self.current_histograms }
    package func heatmaps() HeatmapSeries[] { return self.current_heatmaps }
    package func bands() BandSeries[] { return self.current_bands }
    package func errors() ErrorSeries[] { return self.current_errors }
    package func boxes() BoxSeries[] { return self.current_boxes }
    package func candles() CandleSeries[] { return self.current_candles }
    package func areas() AreaSeries[] { return self.current_areas }
    package func area_mode() AreaMode { return self.current_area_mode }
    package func fill_opacity_amount() float { return self.current_fill_opacity }
    package func smoothing_enabled() bool { return self.current_smooth }
    package func is_circular() bool { return self.current_circular.count() != 0 }
    package func circular() Series { return self.current_circular[0] }
    package func palette_color(index:int) Color { return self.current_palette.color(index) }
    package func inner_radius_amount() float { return self.current_inner_radius }
    package func slice_gap_degrees() float { return self.current_slice_gap }
    package func start_angle_degrees() float { return self.current_start_angle }
    package func slice_offsets() float[] { return self.current_slice_offsets }
    package func label_placement() LabelPlacement { return self.current_label_placement }
    package func percentages_visible() bool { return self.current_percentages }
    package func is_hierarchy() bool { return self.current_hierarchy.count() != 0 }
    package func hierarchy() HierarchySeries { return self.current_hierarchy[0] }
    package func horizontal_lines() ReferenceLine[] { return self.current_horizontal }
    package func vertical_lines() ReferenceLine[] { return self.current_vertical }
    package func heading() str { return self.current_title }
    package func horizontal_label() str { return self.current_x_label }
    package func vertical_label() str { return self.current_y_label }
    package func horizontal_categories() str[] { return self.current_x_categories }
    package func vertical_categories() str[] { return self.current_y_categories }
    package func horizontal_scale() Scale { return self.current_x_scale }
    package func vertical_scale() Scale { return self.current_y_scale }
    package func horizontal_decimals() int { return self.current_x_decimals }
    package func vertical_decimals() int { return self.current_y_decimals }

    package func legend_placement(cell_width:float) LegendPlacement {
        if self.current_legend != LegendPlacement.automatic() { return self.current_legend }
        let entries = self.legend()
        if entries.count() <= 1 { return LegendPlacement.hidden() }
        var inline_width = self.title_width() + 8.0
        for entry in entries {
            inline_width += legend_entry_width(entry.label)
        }
        if entries.count() <= 3 && inline_width <= cell_width - 88.0 {
            return LegendPlacement.inline()
        }
        if cell_width >= 444.0 { return LegendPlacement.right() }
        return LegendPlacement.inside()
    }

    package func title_width() float {
        return Grapheme.count(self.current_title) as float * 9.0
    }

    package func legend_alignment() LegendAlignment { return self.current_legend_alignment }

    package func inline_legend_width() float {
        var width = 0.0
        for entry in self.legend() { width += legend_entry_width(entry.label) }
        return width
    }

    package func is_empty() bool {
        return self.current_lines.count() == 0 &&
            self.current_scatters.count() == 0 &&
            self.current_bars.count() == 0 &&
            self.current_histograms.count() == 0 &&
            self.current_heatmaps.count() == 0 &&
            self.current_bands.count() == 0 &&
            self.current_errors.count() == 0 &&
            self.current_boxes.count() == 0 &&
            self.current_candles.count() == 0 &&
            self.current_areas.count() == 0 &&
            self.current_circular.count() == 0 &&
            self.current_hierarchy.count() == 0
    }

    package func bounds() Bounds {
        if self.is_empty() { panic("Plot chart requires at least one data series") }
        if self.is_circular() || self.is_hierarchy() { panic("Plot shaped charts do not have Cartesian bounds") }
        let limit = 100000000000000000000000000000000000000.0
        var result = Bounds(x_min:limit, x_max:-limit, y_min:limit, y_max:-limit)
        for series in self.current_lines { result = include_xy(result, series.x, series.y) }
        for series in self.current_scatters { result = include_xy(result, series.x, series.y) }
        result = self.include_area_bounds(result)
        for series in self.current_bands {
            result = include_xy(result, series.x, series.lower)
            result = include_xy(result, series.x, series.upper)
        }
        for series in self.current_errors {
            result = include_xy(result, series.x, series.lower)
            result = include_xy(result, series.x, series.upper)
        }
        for series in self.current_bars {
            result = include_point(result, -0.5, 0.0)
            result = include_point(result, series.values.count() as float - 0.5, 0.0)
            for value in series.values { result = include_point(result, 0.0, value) }
        }
        for series in self.current_histograms {
            result = include_point(result, series.edges[0], 0.0)
            result = include_point(result, series.edges[series.edges.count() - 1], 0.0)
            for value in series.counts { result = include_point(result, series.edges[0], value) }
        }
        for series in self.current_heatmaps {
            if self.current_x_categories.count() != 0 && self.current_x_categories.count() != series.columns {
                panic("Plot heatmap x categories must match its columns")
            }
            if self.current_y_categories.count() != 0 && self.current_y_categories.count() != series.rows {
                panic("Plot heatmap y categories must match its rows")
            }
            result = include_point(result, 0.0, 0.0)
            result = include_point(result, series.columns as float, series.rows as float)
        }
        var box_index = 0
        for series in self.current_boxes {
            result = include_point(result, box_index as float - 0.5, series.minimum)
            result = include_point(result, box_index as float + 0.5, series.maximum)
            box_index++
        }
        for series in self.current_candles {
            result = include_xy(result, series.x, series.low)
            result = include_xy(result, series.x, series.high)
            var candle_x_min = series.x[0]
            var candle_x_max = series.x[0]
            var candle_y_min = series.low[0]
            var candle_y_max = series.high[0]
            var candle_index = 1
            while candle_index < series.x.count() {
                candle_x_min = Math.min(candle_x_min, series.x[candle_index])
                candle_x_max = Math.max(candle_x_max, series.x[candle_index])
                candle_y_min = Math.min(candle_y_min, series.low[candle_index])
                candle_y_max = Math.max(candle_y_max, series.high[candle_index])
                candle_index++
            }
            if series.x.count() > 1 {
                if self.current_x_scale == Scale.logarithmic() {
                    result = include_point(result, candle_x_min / 1.08, candle_y_min)
                    result = include_point(result, candle_x_max * 1.08, candle_y_max)
                } else {
                    let candle_spacing = (candle_x_max - candle_x_min) /
                        (series.x.count() - 1) as float
                    result = include_point(result, candle_x_min - candle_spacing * 0.38, candle_y_min)
                    result = include_point(result, candle_x_max + candle_spacing * 0.38, candle_y_max)
                }
            }
            if self.current_y_scale == Scale.logarithmic() {
                result = include_point(result, candle_x_min, candle_y_min / 1.05)
                result = include_point(result, candle_x_max, candle_y_max * 1.05)
            } else {
                let candle_padding = (candle_y_max - candle_y_min) * 0.04
                result = include_point(result, candle_x_min, candle_y_min - candle_padding)
                result = include_point(result, candle_x_max, candle_y_max + candle_padding)
            }
        }
        for line in self.current_horizontal {
            result.y_min = Math.min(result.y_min, line.value)
            result.y_max = Math.max(result.y_max, line.value)
        }
        for line in self.current_vertical {
            result.x_min = Math.min(result.x_min, line.value)
            result.x_max = Math.max(result.x_max, line.value)
        }
        let continuous_x = self.current_lines.count() > 0 ||
            self.current_scatters.count() > 0 ||
            self.current_areas.count() > 0 ||
            self.current_bands.count() > 0 ||
            self.current_errors.count() > 0
        let visible_y = continuous_x || self.current_bars.count() > 0 ||
            self.current_histograms.count() > 0 || self.current_boxes.count() > 0
        if continuous_x && result.x_min != result.x_max {
            if self.current_x_scale == Scale.logarithmic() {
                result.x_min /= 1.03
                result.x_max *= 1.03
            } else {
                let padding = (result.x_max - result.x_min) * 0.025
                result.x_min -= padding
                result.x_max += padding
            }
        }
        if visible_y && result.y_min != result.y_max {
            if self.current_y_scale == Scale.logarithmic() {
                result.y_min /= 1.05
                result.y_max *= 1.05
            } else {
                let padding = (result.y_max - result.y_min) * 0.04
                let preserve_zero = result.y_min == 0.0 &&
                    (self.current_bars.count() > 0 || self.current_histograms.count() > 0)
                if !preserve_zero { result.y_min -= padding }
                result.y_max += padding
            }
        }
        result = expand_bounds(result, self.current_x_scale, self.current_y_scale)
        if self.current_x_scale == Scale.logarithmic() && result.x_min <= 0.0 {
            panic("Plot logarithmic x scale requires strictly positive values")
        }
        if self.current_y_scale == Scale.logarithmic() && result.y_min <= 0.0 {
            panic("Plot logarithmic y scale requires strictly positive values")
        }
        return result
    }

    package func legend() LegendEntry[] {
        var entries:LegendEntry[] = []
        for value in self.current_bands { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.band(), label:value.label, color:value.color)) } }
        for value in self.current_areas { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.area(), label:value.label, color:value.color)) } }
        for value in self.current_bars { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.bar(), label:value.label, color:value.color)) } }
        for value in self.current_histograms { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.histogram(), label:value.label, color:value.color)) } }
        for value in self.current_lines { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.line(), label:value.label, color:value.color)) } }
        for value in self.current_scatters { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.scatter(), label:value.label, color:value.color)) } }
        for value in self.current_errors { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.error_bars(), label:value.label, color:value.color)) } }
        for value in self.current_boxes { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.box_plot(), label:value.label, color:value.color)) } }
        for value in self.current_candles { if value.label != "" { entries.append(LegendEntry(kind:MarkKind.candlesticks(), label:value.label, color:0)) } }
        if self.is_circular() {
            let circular = self.circular()
            var index = 0
            while index < circular.labels.count() {
                if circular.labels[index] != "" {
                    entries.append(LegendEntry(kind:MarkKind.sector(), label:circular.labels[index], color:index))
                }
                index++
            }
        }
        return entries
    }

    private func take_color() int {
        let color = self.next_color
        self.next_color++
        return color
    }

    private func set_circular(labels:str[], values:float[], maximum:float, kind:Kind) {
        if !self.is_empty() { panic("Plot circular charts cannot be mixed with Cartesian marks") }
        if labels.count() == 0 || labels.count() != values.count() {
            panic("Plot circular charts require one label for each value")
        }
        validate_finite(values, "circular chart")
        var positive = false
        for value in values {
            if value < 0.0 { panic("Plot circular chart values cannot be negative") }
            if value > 0.0 { positive = true }
        }
        if !positive && kind != Kind.gauge() {
            panic("Plot circular charts require at least one positive value")
        }
        self.current_circular.append(Series(labels:labels, values:values, maximum:maximum, kind:kind))
        for value in values { self.current_slice_offsets.append(0.0) }
    }

    private func set_areas(x:float[], values:float[][], labels:str[], mode:AreaMode) {
        self.require_cartesian()
        if self.current_areas.count() != 0 || values.count() == 0 {
            panic("Plot composed areas require a new chart and at least one series")
        }
        if labels.count() != 0 && labels.count() != values.count() {
            panic("Plot composed areas require one label for each series")
        }
        var index = 0
        while index < values.count() {
            validate_xy(x, values[index], "composed area")
            for value in values[index] {
                if value < 0.0 { panic("Plot stacked and normalized areas cannot contain negative values") }
            }
            var label = ""
            if labels.count() != 0 { label = labels[index] }
            self.current_areas.append(AreaSeries(
                x:x, y:values[index], label:label, color:self.take_color()
            ))
            index++
        }
        self.current_area_mode = mode
    }

    private func set_hierarchy(labels:str[], values:float[], kind:HierarchyKind) {
        if !self.is_empty() { panic("Plot hierarchy charts cannot be mixed with other marks") }
        if labels.count() == 0 || labels.count() != values.count() {
            panic("Plot hierarchy charts require one label for each value")
        }
        validate_finite(values, "hierarchy chart")
        var positive = false
        for value in values {
            if value < 0.0 { panic("Plot hierarchy chart values cannot be negative") }
            if value > 0.0 { positive = true }
        }
        if !positive { panic("Plot hierarchy charts require at least one positive value") }
        self.current_hierarchy.append(HierarchySeries(labels:labels, values:values, kind:kind))
    }

    private func include_area_bounds(bounds:Bounds) Bounds {
        var result = bounds
        if self.current_areas.count() == 0 { return result }
        if self.current_area_mode == AreaMode.normalized() {
            for x in self.current_areas[0].x { result = include_point(result, x, 0.0); result = include_point(result, x, 1.0) }
            return result
        }
        let first_area = self.current_areas[0]
        var totals = zero_values(first_area.x.count())
        for series in self.current_areas {
            result = include_xy(result, series.x, series.y)
            for x in series.x { result = include_point(result, x, 0.0) }
            if self.current_area_mode == AreaMode.stacked() {
                var index = 0
                while index < totals.count() {
                    totals[index] += series.y[index]
                    result = include_point(result, series.x[index], totals[index])
                    index++
                }
            }
        }
        return result
    }

    private func require_circular() {
        if !self.is_circular() { panic("Plot circular styling requires a circular chart") }
    }

    private func require_labeled_shape() {
        if !self.is_circular() && !self.is_hierarchy() {
            panic("Plot label placement requires a circular, pyramid, or funnel chart")
        }
    }

    private func require_cartesian() {
        if self.is_circular() || self.is_hierarchy() {
            panic("Plot Cartesian marks cannot be mixed with a shaped chart")
        }
    }
}

func require_x_values(expected:float[], actual:float[]) {
    if expected.count() != actual.count() { panic("Plot stacked areas require matching x values") }
    var index = 0
    while index < expected.count() {
        if expected[index] != actual[index] { panic("Plot stacked areas require matching x values") }
        index++
    }
}

package func zero_values(count:int) float[] {
    var result:float[] = []
    var index = 0
    while index < count { result.append(0.0); index++ }
    return result
}

func validate_xy(x:float[], y:float[], kind:str) {
    if x.count() == 0 { panic("Plot $(kind) data cannot be empty") }
    if x.count() != y.count() { panic("Plot $(kind) requires matching x and y values") }
    validate_finite(x, kind)
    validate_finite(y, kind)
}

func validate_finite(values:float[], kind:str) {
    for value in values {
        if !Math.is_finite(value) { panic("Plot $(kind) accepts only finite values") }
    }
}

func validate_value(value:float, kind:str) {
    if !Math.is_finite(value) { panic("Plot $(kind) accepts only finite values") }
}

func sum(values:float[]) float {
    var result = 0.0
    for value in values { result += value }
    return result
}

func maximum_value(values:float[]) float {
    if values.count() == 0 { return 0.0 }
    var result = values[0]
    for value in values { result = Math.max(result, value) }
    return result
}

func validate_decimals(digits:int) {
    if digits < 0 || digits > 6 {
        panic("Plot axis decimals must be between 0 and 6")
    }
}

func require_categories(expected:str[], actual:str[]) {
    if expected.count() != actual.count() { panic("Plot grouped bars require matching categories") }
    var index = 0
    while index < expected.count() {
        if expected[index] != actual[index] { panic("Plot grouped bars require matching categories") }
        index++
    }
}

func sort_values(values:&float[..]) {
    var index = 1
    while index < values.count() {
        let value = values[index]
        var position = index
        while position > 0 && values[position - 1] > value {
            values[position] = values[position - 1]
            position--
        }
        values[position] = value
        index++
    }
}

func quantile(values:float[], amount:float) float {
    let position = amount * (values.count() - 1) as float
    let lower = Math.floor(position) as int
    var upper = lower + 1
    if upper >= values.count() { upper = values.count() - 1 }
    let fraction = position - lower as float
    return values[lower] + (values[upper] - values[lower]) * fraction
}

func include_xy(bounds:Bounds, x:float[], y:float[]) Bounds {
    var result = bounds
    var index = 0
    while index < x.count() {
        result = include_point(result, x[index], y[index])
        index++
    }
    return result
}

func include_point(bounds:Bounds, x:float, y:float) Bounds {
    return Bounds(
        x_min:Math.min(bounds.x_min, x),
        x_max:Math.max(bounds.x_max, x),
        y_min:Math.min(bounds.y_min, y),
        y_max:Math.max(bounds.y_max, y)
    )
}

func expand_bounds(bounds:Bounds, x_scale:Scale, y_scale:Scale) Bounds {
    var result = bounds
    if result.x_min == result.x_max {
        if x_scale == Scale.logarithmic() {
            result.x_min /= 10.0
            result.x_max *= 10.0
        } else {
            let padding = Math.max(Math.abs(result.x_min) * 0.05, 0.5)
            result.x_min -= padding
            result.x_max += padding
        }
    }
    if result.y_min == result.y_max {
        if y_scale == Scale.logarithmic() {
            result.y_min /= 10.0
            result.y_max *= 10.0
        } else {
            let padding = Math.max(Math.abs(result.y_min) * 0.05, 0.5)
            result.y_min -= padding
            result.y_max += padding
        }
    }
    return result
}

func scale_value(value:float, scale:Scale) float {
    if scale == Scale.logarithmic() { return Math.log10(value) }
    return value
}

package func tick_decimals(minimum:float, maximum:float, scale:Scale, configured:int) int {
    if configured >= 0 { return configured }
    var step = Math.abs(maximum - minimum) / 5.0
    if scale == Scale.logarithmic() {
        step = Math.abs(Math.log10(maximum) - Math.log10(minimum)) / 5.0
    }
    if step >= 1.0 { return 0 }
    if step >= 0.1 { return 1 }
    if step >= 0.01 { return 2 }
    if step >= 0.001 { return 3 }
    if step >= 0.0001 { return 4 }
    if step >= 0.00001 { return 5 }
    return 6
}

package func format_tick(value:float, decimals:int) str {
    let factor = Math.pow(10.0, decimals as float)
    var rounded = Math.round(value * factor) / factor
    if Math.abs(rounded) < 0.5 / factor { rounded = 0.0 }
    return "$(rounded)"
}

package func legend_entry_width(label:str) float {
    return Grapheme.count(label) as float * 7.0 + 32.0
}

func plot_x(value:float, bounds:Bounds, area:Area, scale:Scale) float {
    let minimum = scale_value(bounds.x_min, scale)
    let maximum = scale_value(bounds.x_max, scale)
    return area.left + (scale_value(value, scale) - minimum) / (maximum - minimum) * area.width
}

func plot_y(value:float, bounds:Bounds, area:Area, scale:Scale) float {
    let minimum = scale_value(bounds.y_min, scale)
    let maximum = scale_value(bounds.y_max, scale)
    return area.top + area.height -
        (scale_value(value, scale) - minimum) / (maximum - minimum) * area.height
}
