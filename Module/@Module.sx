public use Plot.Chart.Chart
public use Plot.Figure.Figure
public use Plot.Style.Color
public use Plot.Style.Palette

public func grid(rows:int, columns:int) Figure {
    return Figure(rows, columns)
}

public func line(x:float[], y:float[], label:str = "") Figure {
    return Figure()..line(x, y, label)
}

public func scatter(x:float[], y:float[], label:str = "") Figure {
    return Figure()..scatter(x, y, label)
}

public func area(x:float[], y:float[], label:str = "") Figure {
    return Figure()..area(x, y, label)
}

public func stacked_area(x:float[], values:float[][], labels:str[] = []) Figure {
    return Figure()..stacked_area(x, values, labels)
}

public func normalized_area(x:float[], values:float[][], labels:str[] = []) Figure {
    return Figure()..normalized_area(x, values, labels)
}

public func bar(categories:str[], values:float[], label:str = "") Figure {
    return Figure()..bar(categories, values, label)
}

public func histogram(values:float[], bins:int = 20, label:str = "") Figure {
    return Figure()..histogram(values, bins, label)
}

public func heatmap(values:float[], columns:int, label:str = "") Figure {
    return Figure()..heatmap(values, columns, label)
}

public func band(x:float[], lower:float[], upper:float[], label:str = "") Figure {
    return Figure()..band(x, lower, upper, label)
}

public func error_bars(
    x:float[],
    y:float[],
    lower:float[],
    upper:float[],
    label:str = ""
) Figure {
    return Figure()..error_bars(x, y, lower, upper, label)
}

public func box_plot(values:float[], label:str = "") Figure {
    return Figure()..box_plot(values, label)
}

public func candlesticks(
    x:float[],
    open:float[],
    high:float[],
    low:float[],
    close:float[],
    label:str = ""
) Figure {
    return Figure()..candlesticks(x, open, high, low, close, label)
}

public func pie(labels:str[], values:float[]) Figure {
    return Figure()..pie(labels, values)
}

public func donut(labels:str[], values:float[]) Figure {
    return Figure()..donut(labels, values)
}

public func gauge(value:float, maximum:float = 100.0, label:str = "") Figure {
    return Figure()..gauge(value, maximum, label)
}

public func polar_bar(labels:str[], values:float[], maximum:float = 0.0) Figure {
    return Figure()..polar_bar(labels, values, maximum)
}

public func pyramid(labels:str[], values:float[]) Figure {
    return Figure()..pyramid(labels, values)
}

public func funnel(labels:str[], values:float[]) Figure {
    return Figure()..funnel(labels, values)
}
