use Plot

func main() {
    var figure = Plot.grid(2, 2)
        ..title("Indicateurs produit")
        ..size(1200, 820)

    figure.at(0, 0)
        ..pie(["Produit", "Services", "Support"], [52.0, 31.0, 17.0])
        ..title("Revenu")
        ..palette(Plot.Palette.sunset())
        ..show_percentages()

    figure.at(0, 1)
        ..donut(["Desktop", "Web", "Mobile"], [48.0, 34.0, 18.0])
        ..title("Plateformes")
        ..palette(Plot.Palette.ocean())
        ..labels_outside()
        ..show_percentages()

    figure.at(1, 0)
        ..gauge(82.0, 100.0, "Qualité")
        ..title("Objectif trimestriel")
        ..palette(Plot.Palette.ocean())

    figure.at(1, 1)
        ..polar_bar(["API", "Tests", "Docs", "Perf"], [82.0, 71.0, 64.0, 91.0], 100.0)
        ..title("Couverture")
        ..palette(Plot.Palette.neon())
        ..labels_outside()
        ..show_percentages()

    figure.show()
}
